<script>
function go(name){
  document.querySelectorAll('.screen-view').forEach(el=>el.classList.remove('active'));
  document.querySelector('[data-screen="'+name+'"]').classList.add('active');
  document.querySelectorAll('.nav-item').forEach(el=>el.classList.remove('active'));
  var navMap = {home:'home', voice:'voice', tasks:'tasks', profile:'profile'};
  if(navMap[name]){ document.querySelector('[data-nav="'+navMap[name]+'"]').classList.add('active'); }
  document.getElementById('content').scrollTop = 0;
}

function showToast(msg){
  var t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(window._toastTimer);
  window._toastTimer = setTimeout(()=>t.classList.remove('show'), 2600);
}

function bookDoctor(btn, dateText){
  btn.textContent = 'பதிவு ✓ ' + dateText;
  btn.classList.add('done');
  btn.disabled = true;
  var banner = document.getElementById('hospital-confirm');
  banner.textContent = '✅ பதிவு உறுதி செய்யப்பட்டது — ' + dateText + '. இந்த நேரம் உங்கள் பணிகள் பட்டியலில் சேர்க்கப்பட்டுள்ளது, அருணுக்கும் தகவல் அனுப்பப்பட்டது.';
  banner.classList.add('show');
  showToast('அப்பாயிண்ட்மென்ட் பதிவு செய்யப்பட்டது ✓');
}

function placeOrder(btnId, bannerId, etaText){
  var btn = document.getElementById(btnId);
  btn.textContent = 'ஆர்டர் செய்யப்பட்டது ✓ — ' + etaText + ' வரும்';
  btn.classList.add('done');
  btn.disabled = true;
  var banner = document.getElementById(bannerId);
  banner.textContent = '✅ ஆர்டர் வைக்கப்பட்டது. வரும் நேரம்: ' + etaText + '. உறுதிச் செய்தி உங்கள் பணிகள் பட்டியலில் காணலாம்.';
  banner.classList.add('show');
  showToast('ஆர்டர் உறுதி செய்யப்பட்டது ✓');
}

function payBill(btn){
  btn.textContent = 'செலுத்தப்பட்டது ✓';
  btn.classList.add('done');
  btn.disabled = true;
  showToast('கட்டணம் செலுத்தப்பட்டது ✓');
}

function listenDemo(){
  var s = document.getElementById('voice-status');
  s.textContent = 'கேட்டுக் கொண்டிருக்கிறேன்…';
  setTimeout(()=>{ s.textContent = 'புரிந்துகொண்டேன், செய்கிறேன்…'; }, 900);
  setTimeout(()=>{ s.textContent = 'தயார்! கீழே பாருங்கள்.'; }, 1900);
}

var sosSteps = [
  {icon:'📍', main:'இருப்பிடம் கண்டறியப்பட்டது', sub:'GPS துல்லியமாக பகிரப்படுகிறது'},
  {icon:'🚑', main:'ஆம்புலன்ஸ் (108) அழைக்கப்படுகிறது', sub:'இணைக்கப்படுகிறது…'},
  {icon:'👨', main:'அருண் (மகன்) - தகவல் அனுப்பப்பட்டது', sub:'SMS + அழைப்பு'},
  {icon:'👩', main:'மீனா (மருமகள்) - தகவல் அனுப்பப்பட்டது', sub:'SMS'}
];

function triggerSOS(){
  var wrap = document.getElementById('sos-steps');
  wrap.innerHTML = '';
  sosSteps.forEach(function(step, i){
    var el = document.createElement('div');
    el.className = 'sos-step';
    el.innerHTML = '<div class="s-icon pending" id="sos-icon-'+i+'">'+step.icon+'</div><div><div class="s-main">'+step.main+'</div><div class="s-sub" id="sos-sub-'+i+'">'+step.sub+'</div></div>';
    wrap.appendChild(el);
  });
  document.getElementById('sos-overlay').classList.add('show');
  sosSteps.forEach(function(step, i){
    setTimeout(function(){
      document.getElementById('sos-icon-'+i).classList.remove('pending');
      document.getElementById('sos-icon-'+i).textContent = '✅';
      document.getElementById('sos-sub-'+i).textContent = 'முடிந்தது';
    }, 600 + i*650);
  });
}
function closeSOS(){ document.getElementById('sos-overlay').classList.remove('show'); }
</script>
